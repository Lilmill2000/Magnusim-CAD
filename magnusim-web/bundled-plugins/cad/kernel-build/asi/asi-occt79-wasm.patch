@@ -62,7 +62,15 @@ inline int HashCode(const PairOfPEdgeBoolean& val,
 
 typedef NCollection_Sequence<void*>                SequenceOfPointer;
 typedef NCollection_List<void*>                    ListOfPointer;
-typedef NCollection_IndexedMap<PairOfPEdgeBoolean> IMapOfPointerBoolean;
+//! OCCT 7.8+ hasher protocol for (edge pointer, flag) pairs: hash = the pointer
+//! (as the old HashCode above), equality = both members.
+struct PairOfPEdgeBooleanHasher
+{
+  size_t operator()(const PairOfPEdgeBoolean& val) const { return std::hash<Edge*>{}(val.first); }
+  bool operator()(const PairOfPEdgeBoolean& a, const PairOfPEdgeBoolean& b) const { return a == b; }
+};
+
+typedef NCollection_IndexedMap<PairOfPEdgeBoolean, PairOfPEdgeBooleanHasher> IMapOfPointerBoolean;
 
 }
 }
